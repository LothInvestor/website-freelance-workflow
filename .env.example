# Copy to .env and fill in. Never commit .env.

# --- Bright Data (Google Maps) ---
# Find these with: bdata pipelines search "google maps"  then  bdata pipelines info <dataset_id>
BRIGHTDATA_DATASET_ID=
BRIGHTDATA_METHOD=
BRIGHTDATA_QUERY_FIELD=keyword
DEFAULT_COUNTRY_CODE=33

# --- Website audit (only for --deep / --visual) ---
# Free key: https://developers.google.com/speed/docs/insights/v5/get-started (keyless quota is exhausted)
PAGESPEED_API_KEY=
# Claude design review (--visual): pip install anthropic, then set a key (or use `ant auth login`)
ANTHROPIC_API_KEY=

# --- SMTP (Gmail: smtp.gmail.com + an App Password; OVH: ssl0.ovh.net) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
EMAIL_DELAY_SECONDS=45

# --- Your signature (used in templates) ---
SENDER_NAME=
SENDER_SITE=
SENDER_PHONE=
